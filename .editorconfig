# The one editor setting file every editor understands. It covers whitespace
# and encoding — not language associations, which is why .vscode and .zed sit
# beside it with the parts only they can express.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[*.{sfht,phpx}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
