# ======================================================
# APPLICATION
# ======================================================
# Read by app/config/config.php, which runs on every request.

APP_NAME=SfphpProject
APP_VERSION=1.0.0

# "production" or "development".
APP_ENV=development

# Language used when the client asks for none the application offers.
APP_LOCALE=en

# Languages the application offers, in order of preference.
APP_LOCALES=en,pt_BR,es

# The zone times are DISPLAYED in. Storage is always UTC and is not
# configurable: a setting that changes how stored timestamps are interpreted can
# silently rewrite the meaning of existing rows. Changing this changes nothing
# in the database.
APP_TIMEZONE=UTC

# ======================================================
# SESSION
# ======================================================
# Where sessions are stored: "native" (PHP's own files), "database" or "cache".
# Native files are local to one machine, so two instances cannot see each
# other's sessions — which is what forces sticky sessions on a load balancer.
SESSION_DRIVER=native

# Seconds of inactivity before a session ends. 0 disables it.
SESSION_LIFETIME=7200

# Seconds since creation before a session ends, however busy it has been.
# This is the one an audit asks about: it limits how long a stolen cookie is
# worth having. 0 disables it.
SESSION_ABSOLUTE_LIFETIME=43200

# The table the "database" driver writes to. Create it with ./sfphp migrate
# SESSION_TABLE=sessions


# ======================================================
# MAIL
# ======================================================
# Where messages go: "smtp", "mail" (PHP's mail(), development only), "log"
# (records instead of sending — the default) or "array" (keeps them in memory).
MAIL_DRIVER=log

# The SMTP settings. Every contracted service speaks SMTP — SES, Postmark,
# SendGrid, Mailgun, Resend, Brevo — so changing provider is these four values
# and nothing else.
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.provider.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# "tls" for STARTTLS (usually port 587), "ssl" for implicit TLS (usually 465),
# "none" for a local server that has neither.
# MAIL_ENCRYPTION=tls

# Seconds to wait for the connection and for each reply.
# MAIL_TIMEOUT=30

# The sender every message gets unless it names its own. The address has to be
# one the provider has let you verify, or it will refuse to send it.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Send everything to this address instead of its real recipients. For a staging
# environment working from a copy of production data, where the addresses in
# the database belong to real people.
# MAIL_ALWAYS_TO=equipe@exemplo.com

# Sending is only half of arriving. SPF, DKIM and DMARC are DNS records on your
# own domain, and the provider tells you what they must contain; without them a
# message lands in spam or is refused outright. No framework can do that part.


# ======================================================
# LOGGING
# ======================================================
# Where records go: "stream" (default), "error_log", or "null" to discard.
LOG_CHANNEL=stream

# The stream or file the "stream" channel writes to. Defaults to stderr, which
# is where a container expects an application's logs and needs no directory to
# exist. A path is created if its directory is missing.
# LOG_PATH=php://stderr
# LOG_PATH=storage/logs/app.log

# The least severe level written: debug, info, notice, warning, error,
# critical, alert, emergency. Defaults to debug in development, info otherwise.
# LOG_LEVEL=info


# Proxies whose X-Forwarded-* headers may be believed, comma separated.
# REQUIRED behind a TLS-terminating load balancer: without it the session
# cookie loses its "secure" flag and every request looks like it came from the
# balancer. Accepts addresses and CIDR ranges.
# TRUSTED_PROXIES=10.0.0.0/8,172.16.0.5


# ======================================================
# DATABASE CONFIGURATION
# ======================================================
# Set the database driver you want to use.
# Supported PDO drivers (depending on PHP installation):
# mysql, pgsql, sqlite, sqlsrv, oci, firebird, dblib

DB_DRIVER=mysql
# For any PDO driver not covered below, provide the native DSN directly.
# DB_DSN=odbc:Driver={PostgreSQL Unicode};Server=localhost;Database=database_name


# ======================================================
# MySQL / MariaDB
# Requires: pdo_mysql
# ======================================================
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=database_name
# DB_USER=root
# DB_PASS=password
# DB_CHARSET=utf8mb4


# ======================================================
# PostgreSQL
# Requires: pdo_pgsql
# ======================================================
# DB_DRIVER=pgsql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=database_name
# DB_USER=postgres
# DB_PASS=password


# ======================================================
# SQLite
# Requires: pdo_sqlite
# ======================================================
# DB_DRIVER=sqlite
# DB_NAME=database.sqlite
# (DB_HOST, DB_PORT, DB_USER, DB_PASS not required)


# ======================================================
# SQL Server
# Requires: pdo_sqlsrv (Windows) or dblib (Linux alternative)
# ======================================================
# DB_DRIVER=sqlsrv
# DB_HOST=localhost
# DB_PORT=1433
# DB_NAME=database_name
# DB_USER=sa
# DB_PASS=password


# ======================================================
# Oracle
# Requires: pdo_oci
# ======================================================
# DB_DRIVER=oci
# DB_HOST=localhost
# DB_PORT=1521
# DB_NAME=XE
# DB_USER=system
# DB_PASS=password


# ======================================================
# Firebird
# Requires: pdo_firebird
# ======================================================
# DB_DRIVER=firebird
# DB_HOST=localhost
# DB_PORT=3050
# DB_NAME=/path/to/database.fdb
# DB_USER=SYSDBA
# DB_PASS=masterkey


# ======================================================
# Sybase / FreeTDS (Linux SQL Server alternative)
# Requires: pdo_dblib
# ======================================================
# DB_DRIVER=dblib
# DB_HOST=localhost
# DB_PORT=1433
# DB_NAME=database_name
# DB_USER=sa
# DB_PASS=password


# ======================================================
# JWT CONFIGURATION
# ======================================================
# Required to issue or validate tokens. Must be at least 32 bytes, and the
# placeholder below is rejected on purpose. Generate one with:
#
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"

JWT_KEY=your_secret_token_here
