<?php

namespace SfphpProject\app\components\streams\explain;

use SfphpProject\src\View\Sfht;

function HowItWorks(): Sfht
{
    return Sfht(
        <div class="mt-12">
            <h2 class="text-2xl font-bold mb-6">How It Works</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <!-- Text Streaming -->
                <div class="bg-white border border-gray-300 rounded-lg p-6">
                    <h3 class="text-lg font-bold mb-3 flex items-center">
                        <span class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center mr-3 text-sm font-bold">1</span>
                        Text Streaming
                    </h3>
                    <p class="text-sm text-gray-700 mb-3">
                        The server sends the response body in chunks as data becomes available.
                        The browser receives each chunk and displays it immediately.
                    </p>
                    <p class="text-xs text-gray-600 font-mono bg-gray-50 p-2 rounded">
                        Content-Type: text/html<br>
                        Transfer-Encoding: chunked
                    </p>
                </div>

                <!-- SSE -->
                <div class="bg-white border border-gray-300 rounded-lg p-6">
                    <h3 class="text-lg font-bold mb-3 flex items-center">
                        <span class="w-8 h-8 rounded-full bg-green-600 text-white flex items-center justify-center mr-3 text-sm font-bold">2</span>
                        Server-Sent Events
                    </h3>
                    <p class="text-sm text-gray-700 mb-3">
                        The server sends named events with data. The browser's EventSource API
                        automatically parses them and triggers event listeners.
                    </p>
                    <p class="text-xs text-gray-600 font-mono bg-gray-50 p-2 rounded">
                        Content-Type: text/event-stream<br>
                        event: progress<br>
                        data: 50% complete
                    </p>
                </div>
            </div>

            <!-- Use Cases -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                <h3 class="text-lg font-bold mb-3">Common Use Cases</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                    <div>
                        <h4 class="font-bold text-blue-900 mb-2">🤖 AI Responses</h4>
                        <p class="text-gray-700">
                            Stream LLM output token-by-token for responsive UX.
                        </p>
                    </div>
                    <div>
                        <h4 class="font-bold text-blue-900 mb-2">📊 Progress Updates</h4>
                        <p class="text-gray-700">
                            Real-time progress on long-running tasks (uploads, exports).
                        </p>
                    </div>
                    <div>
                        <h4 class="font-bold text-blue-900 mb-2">📝 Live Logs</h4>
                        <p class="text-gray-700">
                            Stream log output as it's generated by background jobs.
                        </p>
                    </div>
                </div>
            </div>

            <!-- API Reference -->
            <div class="mt-8 bg-gray-50 border border-gray-300 rounded-lg p-6">
                <h3 class="text-lg font-bold mb-4">API Reference</h3>

                <div class="space-y-6">
                    <!-- Server-side -->
                    <div>
                        <h4 class="font-bold text-gray-900 mb-2">Server-Side (PHP)</h4>
                        <p class="text-sm text-gray-600 mb-2">Use <code class="bg-white px-1 py-0.5 rounded border border-gray-300">Response::stream()</code> to send chunks:</p>
                        <pre class="bg-white border border-gray-300 rounded p-3 text-xs overflow-x-auto"><code class="text-gray-800">$response = Response::stream(
    function (StreamWriter $out) {
        $out->write("Chunk 1");
        $out->write("Chunk 2");
    },
    headers: ['Content-Type' => 'text/html']
);</code></pre>
                    </div>

                    <!-- Client-side -->
                    <div>
                        <h4 class="font-bold text-gray-900 mb-2">Client-Side (JavaScript)</h4>
                        <p class="text-sm text-gray-600 mb-2">Use SFJS attributes in HTML:</p>
                        <pre class="bg-white border border-gray-300 rounded p-3 text-xs overflow-x-auto"><code class="text-gray-800">&lt;!-- Text streaming --&gt;
&lt;button @stream="/stream" @target="#output"&gt;
    Stream Text
&lt;/button&gt;

&lt;!-- Server-Sent Events --&gt;
&lt;div @stream="/events" @sse @events="progress,complete" @trigger="load"&gt;
    Events here
&lt;/div&gt;</code></pre>
                    </div>
                </div>
            </div>
        </div>
    );
}
