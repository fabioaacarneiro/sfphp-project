# IDE
# Editor settings split in two: what belongs to the project is committed, what
# belongs to a person is not. Language associations and Emmet are the project's
# — every contributor needs them for .phpx and .sfht to read correctly.
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Dependencies
vendor/
composer.lock

# Environment
.env
.env.local
.env.*.local

# Cache and logs
var/cache/
var/logs/
storage/
tmp/
/tmp/sfphp-*

# Tests
.phpunit.result.cache
coverage/
html/

# Context files (local development context)
context.md
features-implemented.md

# Development/Agent artifacts (never commit)
# - Phase summary files
# - Async implementation notes
# - LLM/Agent anotations
# - Test/benchmark scripts at root
# - Example files at root
PHASES_SUMMARY.md
PHASE*_SUMMARY.md
ASYNC_SUMMARY.md
ASYNC_IMPLEMENTATION_COMPLETE.md
ASYNC_RUNTIME_AUDIT.md
SFPHP_ASYNC_SYSTEM_FINAL.md
ASYNC_QUICK_START.md
docs/ASYNC_PHASE*.md
docs/ASYNC_USAGE.md
IMPLEMENTATION_NOTES.md
DEVELOPMENT_NOTES.md
context.md
features-implemented.md
_*.md
example-*.php
test-*.php
benchmark-*.php

# Node modules (for VSCode extension)
node_modules/
package-lock.json

# Cache directories and local development
.claude/
benchmarks/

# Published by ./sfphp assets:publish from resources/assets, which is the one
# copy under version control. Two copies of the same file drift.
/public/assets/css/sfcss.css
/public/assets/css/sfcss.min.css
/public/assets/js/sfjs.js
/public/assets/js/sfjs.min.js
/public/assets/.sfphp-published.json
