{
  "colors": {
    "primary": "#0066cc",
    "secondary": "#6c757d",
    "success": "#28a745",
    "danger": "#dc3545",
    "warning": "#ffc107",
    "info": "#17a2b8",
    "light": "#f8f9fa",
    "dark": "#343a40",
    "white": "#ffffff",
    "black": "#000000"
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "3rem"
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "sizes": {
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "2xl": "2rem",
      "3xl": "2.5rem"
    },
    "lineHeight": "1.6",
    "weights": {
      "normal": 400,
      "semibold": 600,
      "bold": 700
    }
  },
  "border": {
    "radius": "0.25rem",
    "color": "#e9ecef",
    "width": "1px"
  },
  "shadows": {
    "sm": "0 0.125rem 0.25rem rgba(0, 0, 0, 0.075)",
    "base": "0 0.5rem 1rem rgba(0, 0, 0, 0.15)",
    "lg": "0 1rem 3rem rgba(0, 0, 0, 0.175)"
  },
  "breakpoints": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "transition": "all 0.3s ease"
}
