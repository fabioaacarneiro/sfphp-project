# What a `composer create-project` delivers, and what it leaves behind.
#
# This package is a project skeleton, not a library: somebody who installs it
# receives a working application to develop, not a framework to wire up. So the
# example application, its views, its routes, its database directory and the
# front controller all travel — they are the project.
#
# What stays behind is what belongs to developing the framework itself rather
# than to developing with it.

# vendor/ is gitignored, so `git archive` never sees it — but a path repository
# copies the working tree, and an inner vendor/ inside the package made the
# console load the framework's own autoloader instead of the project's.
/vendor             export-ignore
/composer.lock      export-ignore

# The framework's own suite and its CI. A project developing against SFPHP
# writes its own tests; these test SFPHP.
/tests              export-ignore
/.github            export-ignore

# The benchmarks measure the framework, and the origin server they measure
# against is a test fixture. Neither belongs in somebody's application.
/benchmarks                 export-ignore
/ASYNC_RUNTIME_AUDIT.md     export-ignore

# Notes and scratch files from building the async runtime. They were shipping:
# a project installed from 0.12.0 received PHASE4_SUMMARY.md and six example
# scripts in its root, which is somebody else's working notes landing in your
# repository.
/ASYNC_IMPLEMENTATION_COMPLETE.md   export-ignore
/ASYNC_QUICK_START.md               export-ignore
/ASYNC_SUMMARY.md                   export-ignore
/PHASE3_SUMMARY.md                  export-ignore
/PHASE4_SUMMARY.md                  export-ignore
/PHASE5_SUMMARY.md                  export-ignore
/SFPHP_ASYNC_SYSTEM_FINAL.md        export-ignore
/benchmark-async.php                export-ignore
/benchmark-comparison.php           export-ignore
/example-async-controller.php       export-ignore
/example-phase4.php                 export-ignore
/example-phase5.php                 export-ignore
/example-simple-async.php           export-ignore
/test-async.php                     export-ignore
/test-integration.php               export-ignore
/test-phase3.php                    export-ignore
/test-phase4.php                    export-ignore
/test-phase5.php                    export-ignore

# The documentation lives on GitHub in three languages, and shipping twelve
# thousand lines of it into every project is not a service to anybody.
/docs               export-ignore
/README.pt-BR.md    export-ignore
/README.es.md       export-ignore

# Checks this repository's own three languages against each other.
/tools/docs-parity.php  export-ignore

/.gitattributes     export-ignore
/.gitignore         export-ignore
