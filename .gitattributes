# What a `composer require` does not need.
#
# Everything here is part of this repository and none of it is part of the
# framework: the example application, its database files, the test suite, the
# documentation in three languages and the CSS builder. Shipping them would put
# an app/ directory inside every consumer's vendor/ — confusing at best, and at
# worst something a stray autoload rule picks up.

# vendor/ is gitignored, so `git archive` never sees it — but a path repository
# copies the working tree, and an inner vendor/ inside the package made the
# console load the framework's own autoloader instead of the project's.
/vendor             export-ignore
/composer.lock      export-ignore

/app                export-ignore
/database           export-ignore
/docs               export-ignore
/public             export-ignore
/tests              export-ignore
# The builders travel: SFCSS is "generated from a config", and that is only
# true for somebody who has the generator. docs-parity checks this repository's
# own three languages and is nobody else's business.
/tools/docs-parity.php  export-ignore
/.github            export-ignore
/lang               export-ignore
/server.php         export-ignore
/.env-example       export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/README.pt-BR.md    export-ignore
/README.es.md       export-ignore

# Keep: composer.json, README.md, LICENSE, sfphp, src/ — which includes
# src/I18n/lang/, the framework's own message catalogs — and resources/assets/,
# which holds SFCSS and SFJS. Those two are tools the framework ships rather
# than files of the example application, so a consumer has to receive them;
# ./sfphp assets:publish copies them into whatever directory a project serves.
